# Chemin vers le projet CICFlowMeter contenant gradlew.bat
CICFLOWMETER_DIR=../CICFlowMeter

# CSV écrit par LiveCaptureCli
CSV_PATH=data/live_flows.csv

# Endpoint de prédiction de FastAPI
API_URL=http://127.0.0.1:8000/api/flows/predict
API_TIMEOUT_SECONDS=15
POLL_INTERVAL_SECONDS=0.5
HTTP_RETRY_SECONDS=3

# Interface Windows : index ou nom (ex. 7 ou Wi-Fi)
NETWORK_INTERFACE=7
APPEND_CSV=false

# false = ignorer les anciennes lignes ; true = traiter tout le CSV au démarrage
START_FROM_BEGINNING=false
